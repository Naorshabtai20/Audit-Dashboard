# Example Vite env file for Audit-Dashboard
# Create a file named `.env` (or `.env.local`) in the project root and set your service URL.
# The app reads VITE_SERVICE_URL at build/runtime and uses it for GET/POST by id.

VITE_SERVICE_URL="https://example.com/service"

# Notes:
# - Do NOT commit secrets into version control.
# - Use full base URL without trailing slash is fine; trailing slash will be trimmed.
# - To override locally create `.env.local` and add the same variable.
